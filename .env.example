# DrishtiAI Platform Environment Variables
# Copy this file to .env and configure provider credentials as needed.

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# JWT Cryptographic Signing Secret (Required for secure role-based session tokens)
JWT_SECRET=replace_with_a_secure_long_random_secret_in_production_2026

# Python AI Microservice URL (Optional, for deep learning auxiliary service)
AI_SERVICE_URL=http://localhost:8000

# SMS Provider Credentials (Twilio / Fast2SMS)
# If left empty, system operates in clinical manual mode and notifications report "Disabled (Provider Not Configured)"
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=DRISHTI
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_PHONE_NUMBER=

# Email Provider Configuration (SMTP)
# If left empty, email delivery reports unconfigured status
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@drishtiai.in

# WebRTC STUN/TURN Infrastructure (Defaults to Google public STUN for development)
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
